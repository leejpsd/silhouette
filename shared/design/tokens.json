{
  "name": "silhouette-tokens",
  "version": 1,
  "status": "v1",
  "units": "Lengths are density-independent: CSS px = Android dp/sp = iOS pt. Durations in ms. Colors are sRGB hex.",
  "color": {
    "light": {
      "background": "#F2F4F3",
      "surface": "#FFFFFF",
      "surfaceSunken": "#E5EAE9",
      "text": "#17222A",
      "textMuted": "#46535D",
      "border": "#D3DADD",
      "borderStrong": "#77858F",
      "primary": "#2F43A0",
      "onPrimary": "#FFFFFF",
      "focus": "#2F43A0",
      "verdictLikely": "#1C6844",
      "verdictMaybe": "#7E5100",
      "verdictDepends": "#46535D",
      "verdictUnlikely": "#86392F",
      "notice": "#FBEFC8",
      "onNotice": "#433000",
      "private": "#E6EAFA",
      "onPrivate": "#22307A",
      "danger": "#9E2A1F",
      "onDanger": "#FFFFFF"
    },
    "dark": {
      "background": "#0E1417",
      "surface": "#172126",
      "surfaceSunken": "#0A0F12",
      "text": "#E7EDEF",
      "textMuted": "#A8B5BD",
      "border": "#2B383F",
      "borderStrong": "#71828C",
      "primary": "#AAB8FF",
      "onPrimary": "#0E1417",
      "focus": "#AAB8FF",
      "verdictLikely": "#7AD3A6",
      "verdictMaybe": "#F0C467",
      "verdictDepends": "#A8B5BD",
      "verdictUnlikely": "#F1AA9F",
      "notice": "#3A2E0A",
      "onNotice": "#F6E2A6",
      "private": "#1C2550",
      "onPrivate": "#D4DBFF",
      "danger": "#FFB4A9",
      "onDanger": "#2B0906"
    }
  },
  "typography": {
    "fontFamily": {
      "text": ["Atkinson Hyperlegible Next Variable", "Atkinson Hyperlegible Next", "Apple SD Gothic Neo", "Noto Sans KR", "Malgun Gothic", "system-ui", "sans-serif"]
    },
    "scale": {
      "display": { "size": 34, "lineHeight": 40, "weight": 700, "letterSpacing": -0.4 },
      "title": { "size": 26, "lineHeight": 32, "weight": 700, "letterSpacing": -0.2 },
      "heading": { "size": 20, "lineHeight": 27, "weight": 700, "letterSpacing": 0 },
      "body": { "size": 18, "lineHeight": 28, "weight": 400, "letterSpacing": 0 },
      "bodyStrong": { "size": 18, "lineHeight": 28, "weight": 650, "letterSpacing": 0 },
      "small": { "size": 16, "lineHeight": 24, "weight": 400, "letterSpacing": 0 }
    }
  },
  "spacing": { "xxs": 4, "xs": 8, "sm": 12, "md": 16, "lg": 24, "xl": 32, "xxl": 48 },
  "radius": { "control": 12, "panel": 20, "pill": 999 },
  "size": { "minTapTarget": 48, "comfortableTapTarget": 56, "readingWidth": 640, "focusRing": 3 },
  "motion": {
    "duration": { "short": 120, "medium": 220 },
    "easing": { "standard": [0.2, 0, 0, 1] },
    "reducedMotion": "Disable all non-essential transitions when the platform asks for reduced motion."
  }
}
