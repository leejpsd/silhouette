    "numOctaves": 2,
    "alpha": 0.9,
    "opacity": 0.1,
    "blend": {
      "dark": "overlay",
      "light": "multiply"
    },
    "native": "Ship a 256 × 256 noise PNG generated from these values; tile it over the screen at 10% with the blend mode. Skip it when the platform asks for reduced transparency."
  },
