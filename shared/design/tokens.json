    "keyframes": {
      "rise": "translateY 14 → 0",
      "wipe": "scaleX .15 → 1 from the left",
      "pop": "scale .9 → 1 from bottom-left",
      "stamp": "scale 1.5 → 1 at -8°",
      "sheetUp": "translateY 40 → 0",
      "march": "dotted fill moves 8 px, loops (loading only)"
    },
    "reducedMotion": "Disable all non-essential transitions when the platform asks for reduced motion. Every keyframe above has an off switch; the preview token cross-fade becomes an instant swap."
  }
