{
  "name": "silhouette-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "npm run lint:routing && tsc --noEmit -p tsconfig.core.json && tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.e2e.json && tsc --noEmit -p tsconfig.eval.json",
    "lint:routing": "node scripts/check-routing.mjs",
    "e2e": "playwright test",
    "eval": "node eval/run.mjs",
    "eval:generate": "node eval/generate.mjs",
    "eval:leaks": "node eval/leakcheck.mjs",
    "capture": "playwright test -c playwright.visual.config.ts",
    "fonts:copy": "node scripts/copy-fonts.mjs"
  },
  "dependencies": {
    "firebase": "^13.3.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource/darker-grotesque": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "rolldown": "^1.2.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
