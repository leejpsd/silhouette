{
  "$id": "pointer.lease.v2",
  "description": "Model output for pointer extraction on a lease skeleton.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "tenantNames": {
      "x-kind": "text",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ref"
      },
      "description": "Names of all tenants: hidden-word ids in reading order"
    },
    "landlordName": {
      "x-kind": "text",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ref"
      },
      "description": "Landlord name: hidden-word ids in reading order"
    },
    "monthlyRent": {
      "x-kind": "number",
      "$ref": "#/$defs/ref",
      "description": "Rent amount per month"
    },
    "deposit": {
      "x-kind": "number",
      "$ref": "#/$defs/ref",
      "description": "Security deposit amount"
    },
    "leaseStart": {
      "x-kind": "date",
      "$ref": "#/$defs/dateRef",
      "description": "Date the lease term starts"
    },
    "leaseEnd": {
      "x-kind": "date",
      "$ref": "#/$defs/dateRef",
      "description": "Date the lease term ends"
    },
    "occupantCount": {
      "x-kind": "number",
      "$ref": "#/$defs/ref",
      "description": "Number of occupants allowed or stated"
    }
  },
  "$defs": {
    "ref": {
      "type": "string",
      "pattern": "^[NDW][0-9]+$"
    },
    "dateRef": {
      "oneOf": [
        {
          "$ref": "#/$defs/ref"
        },
        {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/ref"
          }
        }
      ]
    }
  }
}
