{
  "$id": "pointer.lease.v2",
  "description": "Model output for pointer extraction on a lease skeleton.",
  "$comment": "v2: every property is present in the model output, and null means the field is not in the document. The model schema is derived with required + nullable.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "tenantNames": {
      "x-kind": "text",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "landlordName": {
      "x-kind": "text",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "monthlyRent": {
      "x-kind": "number",
      "$ref": "#/$defs/ref"
    },
    "deposit": {
      "x-kind": "number",
      "$ref": "#/$defs/ref"
    },
    "leaseStart": {
      "x-kind": "date",
      "$ref": "#/$defs/dateRef"
    },
    "leaseEnd": {
      "x-kind": "date",
      "$ref": "#/$defs/dateRef"
    },
    "occupantCount": {
      "x-kind": "number",
      "$ref": "#/$defs/ref"
    }
  },
  "required": [
    "tenantNames",
    "landlordName",
    "monthlyRent",
    "deposit",
    "leaseStart",
    "leaseEnd",
    "occupantCount"
  ],
  "$defs": {
    "ref": {
      "type": "string",
      "pattern": "^[NDW][0-9]+$"
    },
    "dateRef": {
      "oneOf": [
        {
          "$ref": "#/$defs/ref"
        },
        {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/ref"
          }
        }
      ]
    }
  }
}
